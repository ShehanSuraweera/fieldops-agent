# Copy to .env and adjust. docker compose reads .env automatically.

# Postgres
POSTGRES_USER=fieldops
POSTGRES_PASSWORD=fieldops
POSTGRES_DB=fieldops
POSTGRES_PORT=5432

# Enterprise mock (CRM / FSM / ERP)
MOCK_API_KEY=dev-mock-key
MOCK_PORT=8001
# Reference date for seed data (YYYY-MM-DD). Empty = today in Colombo.
# Pin it to make seeded dates fully reproducible.
SEED_TODAY=

# Agent API
AGENT_API_KEY=dev-agent-key
AGENT_PORT=8002
# Pin the agent's clock (ISO datetime, naive = Colombo time). Empty = real time.
AGENT_NOW=

# LLM: gemini (default) | openai | groq. Empty LLM_MODEL = provider default
# (gemini-2.5-flash, gpt-4o-mini, llama-3.3-70b-versatile). Only the chosen provider's key is needed.
LLM_PROVIDER=gemini
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Only used when running the agent outside Docker (compose sets these itself)
MOCK_BASE_URL=http://localhost:8001
# Business-rule thresholds. Default: config/rules.yaml in the repo.
RULES_PATH=
